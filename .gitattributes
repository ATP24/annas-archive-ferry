# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare Windows batch files as CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must use LF
*.sh text eol=lf

# Python source
*.py text diff=python

# Documentation and configs
*.md text
*.json text
*.toml text
*.yaml text
*.yml text
*.txt text
